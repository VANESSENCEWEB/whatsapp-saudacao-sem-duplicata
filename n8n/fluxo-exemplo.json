              "type": "number"
            },
            {
              "id": "cont",
              "name": "content",
              "value": "={{ $json.body?.content ?? $json.content ?? \"\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c700941e-826f-4259-b143-6eaca49fec78",
      "name": "Normaliza Dados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.message_buffer (conversation_id, content) values ($1, $2) returning id, conversation_id;",
        "options": {
          "queryReplacement": "={{ [ $json.conversation_id, $json.content ] }}"
        }
      },
      "id": "0b72ee2f-b6ca-4510-b6a3-fc4e34e9f548",
      "name": "Grava no Buffer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "amount": 30
      },
      "id": "bbb67cb3-6265-44fc-b7f6-dc47d441f60f",
      "name": "Espera 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with marcadas as (\n  update public.message_buffer b\n     set processed = true\n   where b.conversation_id = $1\n     and b.processed = false\n     and not exists (\n       select 1 from public.message_buffer n\n        where n.conversation_id = $1\n          and n.id > $2\n     )\n  returning b.id, b.content\n)\nselect count(*)::int as total,\n       coalesce(string_agg(content, ' | ' order by id), '') as mensagens\n  from marcadas;",
        "options": {
          "queryReplacement": "={{ [ $('Grava no Buffer').item.json.conversation_id, $('Grava no Buffer').item.json.id ] }}"
        }
      },
      "id": "63eb55b7-31e5-45ff-97b4-adaf430d5b8f",
      "name": "Sou a última?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1120,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f63a2901-f78a-46ed-aa50-6288e8423747",
